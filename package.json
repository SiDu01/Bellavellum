{
  "name": "bellavellum",
  "productName": "Bellavellum",
  "version": "0.2.0",
  "private": true,
  "description": "Portable virtual tabletop for the DM",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/main/*.test.ts src/renderer/src/*.test.ts",
    "dist:win": "electron-vite build && electron-builder --win portable",
    "dist:setup": "electron-vite build && electron-builder --win dir && node scripts/setup.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "app.bellavellum",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Bellavellum.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "appImage": {
      "artifactName": "Bellavellum.AppImage"
    }
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.49.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
